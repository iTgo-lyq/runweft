# 原型 R2 发布配置；复制为 .env 并执行 chmod 600 .env。
# 仅用于发布机器，不提交真实凭据，不打包到原型。
# 优先级：进程环境变量 > 根目录 .env.local > 根目录 .env。
# 显式空值不回退；值不做变量插值。
R2_ACCOUNT_ID=
R2_BUCKET=
# 桶的公开 HTTPS 地址（r2.dev 或自定义域名），不是 S3 API 地址。
R2_PUBLIC_BASE_URL=
# 仅授权目标桶 Object Read & Write 的 S3 API 凭据。
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
