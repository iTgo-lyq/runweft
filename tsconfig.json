{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": [
      "bun-types",
      "node"
    ],
    "jsx": "react-jsx",
    "paths": {
      "@runweft/ui": [
        "./packages/ui/src/index.ts"
      ],
      "@runweft/ui/*": [
        "./packages/ui/src/*"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "test/**/*.ts",
    "scripts/**/*.ts",
    "packages/ui/**/*.ts",
    "packages/ui/**/*.tsx",
    "packages/prototype/src/**/*.ts",
    "packages/prototype/src/**/*.tsx"
  ]
}
