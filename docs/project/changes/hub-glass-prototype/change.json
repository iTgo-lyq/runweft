  "clarifications": {
    "Q1": {
      "round": 1,
      "question": "重构范围只做 Hub 与原型，还是同时包含官网？",
      "recommendation": "先做 Hub 与原型；官网的约束和发布链路不同，另开 Change",
      "answer": "目前先只做原型，覆盖 Hub 主体页面",
      "source": "用户：目前只是先做原型，覆盖主体页面即可"
    },
    "Q2": {
      "round": 1,
      "question": "是否加入深色模式？",
      "recommendation": "浅色与深色一起设计，跟随系统并可在演示工具条切换；Craft 参考包含深色层级处理，与浅色同时定 token 比事后补做成本低",
      "answer": "浅色与深色一起做",
      "source": "用户：深浅一起做"
    },
    "Q3": {
      "round": 1,
      "question": "产品前端沿用原生栈只借鉴 shadcnuikit 设计，还是迁移到 React + Tailwind + shadcn？",
      "recommendation": "沿用原生栈：保持 CSP、单二进制与零外部依赖；迁移代价需在技术方案中单独评估",
      "withdrawn": "用户已决定维护自有 UI 库，选型改为在自有库的实现基础之间选择，见 Q6"
    },
    "Q4": {
      "round": 2,
      "question": "原型 8 个入口全做，还是只做最小集（账号与连接、任务、Agent、成员，资源页仅机器作代表）？",
      "recommendation": "8 个全做：资源页共用一套模式，额外成本小，且与后续产品页一一对应",
      "answer": "8 个入口全做",
      "source": "用户：8个入口全做"
    },
    "Q5": {
      "round": 2,
      "question": "原 identity 入口是否并入工作台壳？",
      "recommendation": "并入：账号模式下身份只剩显示名称和空间管理",
      "withdrawn": "核对产品后确认身份与空间位于工作台侧栏，不是独立页面；按事实并入工作台壳，无需取舍"
    },
    "Q6": {
      "round": 3,
      "question": "UI 库与 Hub 前端采用什么技术基础：React 加自有组件（交互基于原生 dialog/popover，样式用 CSS 变量）、原生 TypeScript 组件库，还是 React 加 Radix/shadcn 与 Tailwind？",
      "recommendation": "React 加自有组件：声明式更新便于刷新时保留已读内容与输入，现有严格 CSP 已实验通过；代价是约 58KB gzip 运行时和 React 升级维护",
      "answer": "React 加 Radix/shadcn 与 Tailwind",
      "source": "用户：Q6 我希望是C，CSP是什么，它有保留的必要吗？ 会不会过度设计了。"
    },
    "Q7": {
      "round": 3,
      "question": "原型包是直接运行 Hub 前端页面并接内存接口与演示控制，还是独立实现页面、只共用 UI 库？",
      "recommendation": "直接运行产品页面：界面只有一份实现，原型与产品不走样；纯探索性草图仍可在原型包单独写页面",
      "answer": "原型独立实现页面，只共用 UI 库",
      "source": "用户：Q7 如果合并的话，协作分支的原型改动是不是会影响正式前端，我觉得还是保持独立比较好"
    }
  },
